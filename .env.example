# ─── Loja ───────────────────────────────────────────────────────────────
# Endereço público do site (usado no SEO e no sitemap)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# WhatsApp, Instagram, logo, menu e textos são editados no painel.

# ─── Supabase ───────────────────────────────────────────────────────────
# Enquanto vazios, o site roda em modo demonstração, com dados em .data/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Modo demonstração ──────────────────────────────────────────────────
# Senha do painel enquanto o Supabase não estiver conectado (mínimo de 8 caracteres).
LOCAL_ADMIN_PASSWORD=
